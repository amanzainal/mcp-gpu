# Copy to .env and adjust as needed. .env is gitignored and never committed.

# Set to 1/true/yes/on to force synthetic (mock) GPU data, so the server runs
# on machines with no NVIDIA GPU and in CI. Equivalent to the --mock flag.
MCP_GPU_MOCK=0

# This project needs no API keys or tokens. If you fork it and add an
# integration that does, read every secret from an environment variable here
# and NEVER hardcode it in source or commit a real value.
# EXAMPLE_API_KEY=replace-me
